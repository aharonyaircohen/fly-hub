  "scripts": {
    "build": "tsc --noEmit",
    "build:library": "pnpm --dir ../kody-chat build",
    "pack:library": "pnpm build:library && npm pack ../kody-chat",
    "test:external-package": "pnpm build:library && node scripts/verify-external-package.mjs",
    "test:external-package:registry": "pnpm build:library && KODY_CHAT_PACKAGE_SPEC=registry node scripts/verify-external-package.mjs",
    "publish:library:next": "pnpm test:external-package && npm publish ../kody-chat --tag next --access public",
    "publish:library:latest": "pnpm test:external-package && npm publish ../kody-chat --tag latest --access public",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/int",
    "vault:init": "node scripts/generate-vault-key.mjs"
  },
